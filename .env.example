# Database (Neon PostgreSQL - provided by Vercel Neon integration)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Authentication (Better Auth)
BETTER_AUTH_SECRET=your-cryptographically-secure-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# AI (Vercel AI Gateway - set in Vercel dashboard)
AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT/YOUR_GATEWAY
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BrandGuard

# Demo mode
DEMO_JWT_SECRET=your-demo-jwt-secret-min-32-chars

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
